# Transport: "stub" runs standalone with in-memory demo data; "live" hits the backend.
NEXT_PUBLIC_TRANSPORT=stub
# Base URL of the deployed backend (the persistent host, NOT Vercel). Used when live.
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Supabase auth (optional until you wire real auth; absent = stub user).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
