  "FILES": {
    "run_prompts.py": {
      "code": [
        "# assemble-pinned-qa",
        "",
        "def load_prompts(path):",
        "    return json.load(open(path))",
        "",
        "def normalize_row(r):",
        "    return {**r, \"pin\": bool(r.get(\"pin\"))}",
        "",
        "def _pinned_qa_group(questions):",
        "    pinned = [q for q in questions if q[\"pin\"]]",
        "    rest   = [q for q in questions if not q[\"pin\"]]",
        "    # TODO: id collisions across groups?",
        "    return pinned + rest",
        "",
        "def build_prompt_batch(rows):",
        "    grouped = _pinned_qa_group(rows)",
        "    return [render(r) for r in grouped]"
      ],
