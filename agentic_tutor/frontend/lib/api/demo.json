    "schema_loader.py": {
      "code": [
        "# schema_loader.py",
        "import json",
        "",
        "def read_schema(path):",
        "    with open(path) as fh:",
        "        return json.load(fh)",
        "",
        "def validate_row(row, schema):",
        "    for key in schema[\"required\"]:",
        "        if key not in row:",
        "            raise KeyError(key)",
        "    return True"
      ],
